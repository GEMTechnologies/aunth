# Test scratch state. The suite creates SQLite databases and temp roots to keep
# itself hermetic; none of that is source and none of it may be committed.
pytest-of-*/
pytest_cache/
_schemadiff/
tmp*/
*-test-db-*/

# Secrets. .env files hold live credentials and are never committed.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/